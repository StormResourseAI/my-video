{
  "name": "my-video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.445",
    "@remotion/media": "^4.0.445",
    "@remotion/tailwind-v4": "4.0.445",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.445",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.445",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "ingest": "bash scripts/ingest_media.sh",
    "feedback": "node scripts/feedback.mjs",
    "preset": "node scripts/use-preset.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render MyComp output/video.mp4",
    "render:vertical": "node scripts/render-vertical.mjs",
    "render:demo": "node scripts/render-vertical.mjs demo",
    "render:multi": "remotion render MultiClip output/multi.mp4",
    "render:variants": "remotion render MultiClip-A output/multi-a.mp4 && remotion render MultiClip-B output/multi-b.mp4 && remotion render MultiClip-C output/multi-c.mp4",
    "render:pack": "remotion render MultiClip-A output/multi-a.mp4 && remotion render MultiClip-B output/multi-b.mp4",
    "deliver": "node scripts/package-delivery.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "watch": "node scripts/watch.mjs",
    "beats": "python3 scripts/extract_beats.py input/music.mp3",
    "broll:match": "node scripts/build-broll-manifest.mjs",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
